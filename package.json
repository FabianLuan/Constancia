{
  "name": "constancia",
  "private": true,
  "version": "1.0.0",
  "description": "App de seguimiento de hábitos (PWA) con sincronización en Firebase",
  "scripts": {
    "build": "esbuild src/sync.js --bundle --format=esm --minify --target=es2020 --outfile=public/sync.js && sh build.sh",
    "deploy": "npm run build && firebase deploy --only hosting,firestore:rules"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/browser": "^8.0.5",
    "@capacitor/core": "^8.6.2",
    "@capacitor/local-notifications": "^8.3.1",
    "firebase": "10.12.2"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.2",
    "esbuild": "0.21.5"
  }
}
